# Neon PostgreSQL (pooled connection string recommended for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public URL used for metadata (set in Vercel for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret (min 32 chars; required in production)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
